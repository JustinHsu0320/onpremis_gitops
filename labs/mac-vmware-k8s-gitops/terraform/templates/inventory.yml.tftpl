---
all:
  vars:
    ansible_user: ${ansible_user}
    ansible_become: true
    ansible_python_interpreter: /usr/bin/python3
    control_plane_endpoint: ${control_plane_ip}
  children:
    control_plane:
      hosts:
%{ for name, node in nodes ~}
%{ if node.role == "control_plane" ~}
        ${name}:
          ansible_host: ${node.ip}
%{ endif ~}
%{ endfor ~}
    workers:
      hosts:
%{ for name, node in nodes ~}
%{ if node.role == "workers" ~}
        ${name}:
          ansible_host: ${node.ip}
%{ endif ~}
%{ endfor ~}
    k8s_nodes:
      children:
        control_plane: {}
        workers: {}

