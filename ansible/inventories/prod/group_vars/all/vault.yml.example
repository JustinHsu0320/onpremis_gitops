---
# =============================================================================
# vault.yml — 平台機密（本檔案在 Git 內必須是 ansible-vault 密文）
# 編輯方式： ansible-vault edit inventories/prod/group_vars/all/vault.yml
# 產生原則：每個服務獨立強密碼、絕不共用。
#
# 分層（CONVENTIONS §6）：本檔只放「平台」機密；各專案的機密放獨立密文檔
# vault_prj_<name>.yml（範本見 vault_prj_email_proxy.yml.example）。
#
# 2026-08 平台化改名注意：既有 prod vault 若還在用舊名
# （vault_postgres_app_password / vault_rabbitmq_app_user_password /
#  vault_scylla_app_password / vault_app_jwt_secret / vault_app_encryption_key /
#  vault_microsoft_client_secret / vault_sendgrid_api_key），請把它們「搬到」
# vault_prj_email_proxy.yml 並改用 vault_prj_email_proxy_* 新名（對照表見
# CONVENTIONS §6）。
# =============================================================================
vault_postgres_superuser_password: "CHANGEME"
vault_postgres_replicator_password: "CHANGEME"
vault_pgbouncer_auth_password: "CHANGEME"
vault_pgbouncer_admin_password: "CHANGEME"
vault_patroni_restapi_password: "CHANGEME"
vault_rabbitmq_admin_password: "CHANGEME"
# Erlang cookie：RabbitMQ 叢集節點互認的共享密鑰（等同叢集 root 權限）
vault_rabbitmq_erlang_cookie: "CHANGEME"
vault_keydb_password: "CHANGEME"
# ScyllaDB：專屬超級使用者（取代出廠 cassandra 帳號）。
# 請避免含單引號與雙引號（會破壞 cqlsh 指令的引號結構）；建議純英數
vault_scylla_admin_password: "CHANGEME"
# SeaweedFS：filer 元資料庫的 PG 帳號 + S3 admin 身分（access/secret key）
vault_seaweedfs_pg_password: "CHANGEME"
vault_seaweedfs_s3_admin_access_key: "CHANGEME"
vault_seaweedfs_s3_admin_secret_key: "CHANGEME"
# VRRP 認證密碼上限 8 字元（keepalived 協定限制），每個 VIP 各自獨立
vault_vrrp_pass_svc: "CHANGEME"
vault_vrrp_pass_egress: "CHANGEME"
vault_vrrp_pass_kong: "CHANGEME"
vault_vrrp_pass_pg: "CHANGEME"
vault_vrrp_pass_mq: "CHANGEME"
vault_vrrp_pass_s3: "CHANGEME"
vault_grafana_admin_password: "CHANGEME"
vault_pgbackrest_cipher_pass: "CHANGEME"
vault_gitlab_root_password: "CHANGEME"
