# {{ ansible_managed }}
# =============================================================================
# haproxy-edge.cfg — 邊界層 HAProxy（profile=edge，lb-01/02）
#
# 流量拓撲（junior 請先看懂這張圖再動設定）：
#
#   用戶端
#     │  https://svc-api.{{ domain }}  →  服務 VIP {{ service_vip }}:443
#     ▼
#   fe_https（TLS 在這裡「終止」，憑證 svc-api.pem）
#     │  mode http：解開 TLS 之後才能做 L7 的事（真健檢、X-Forwarded-*、日後的路由規則）
#     ▼
#   be_app  →  app-01..03:{{ app_http_port }}（roundrobin + GET /health 真健檢）
#
#   用戶端
#     │  smtps://svc-api.{{ domain }}  →  服務 VIP {{ service_vip }}:465
#     ▼
#   fe_smtps（TCP passthrough：HAProxy「不解」TLS，只轉位元組）
#     │  mode tcp：TLS 由後端 smtp 服務自持憑證處理
#     ▼
#   be_smtps  →  app-01..03:{{ app_smtp_port }}
#
# 為什麼兩個口的 TLS 策略不同：
#   443 終止於邊界 → 後端 app 收純 HTTP，集中管理憑證、可觀測 L7；
#   465 不終止 → SMTP 的 TLS 語意（客戶端驗的是郵件服務身分）由 smtp 服務
#   自己維護，邊界少一段「解開再加密」的攻擊面與延遲。
#
# 兩台 lb 用「同一份模板」產生設定，backend 由 inventory 的 groups['app']
# 動態展開——這就是規劃書 §7.5 對 config drift 的結構性修正：
# 想讓兩台設定不同步，你得先改壞 inventory 才辦得到。
# =============================================================================

global
    # 全域同時連線上限：超過就讓新連線排隊，而不是耗盡記憶體把自己撐掛
    maxconn {{ haproxy_edge_maxconn }}
    # 日誌走 stdout：haproxy.service 以 -Ws 前景執行，stdout 由 systemd-journald
    # 收容（journalctl -u haproxy），不需要另架 syslog
    log stdout local0 info
    # 降權執行：只有綁 443/465 特權埠的瞬間需要 root，之後全程低權限身分
    user haproxy
    group haproxy
    # 加固：行程視角的檔案系統只剩這個空目錄，就算被打穿也讀不到系統檔
    chroot /var/lib/haproxy
    # Runtime API（維運用：echo "show stat" | socat 等）；
    # expose-fd listeners = 無縫 reload 的關鍵——舊行程把「監聽 socket 的 fd」
    # 經此 socket 交棒給新行程，reload 期間 0 個 SYN 掉包
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    # TLS 底線：TLSv1.0/1.1 已知弱點多且無正當用戶，直接拒收
    ssl-default-bind-options ssl-min-ver TLSv1.2

defaults
    log global
    mode http
    # L7 日誌格式（含方法/路徑/狀態碼/耗時）；tcp 前端各自覆寫成 tcplog
    option httplog
    # 不記錄「連上就斷、零位元組」的健檢與掃描噪音
    option dontlognull
    # 後端節點在「建連階段」失敗時自動改派其他健康節點重試
    option redispatch
    retries 3
    timeout connect {{ haproxy_edge_timeout_connect }}
    timeout client {{ haproxy_edge_timeout_client }}
    timeout server {{ haproxy_edge_timeout_server }}

# -----------------------------------------------------------------------------
# 443：HTTPS 入口（TLS 終止）
# -----------------------------------------------------------------------------
frontend fe_https
    # 綁 *（萬用位址）而非 VIP：MASTER/BACKUP 兩台都常態監聽 443，
    # 「誰收到流量」由 keepalived 決定 VIP 在誰身上——HAProxy 不感知 VRRP 狀態。
    # svc-api.pem 是 pki_leaf 以 bundle_pem 產出的 crt+chain+key 串接檔
    # （HAProxy 的 crt 參數吃這種格式）；alpn 宣告支援 HTTP/2 與 HTTP/1.1，
    # 由客戶端在 TLS 握手時協商
    bind *:443 ssl crt {{ pki_dir }}/svc-api.pem alpn h2,http/1.1
    mode http
    # TLS 終止後，後端看到的來源 IP 是 lb 自己——把真實客戶端 IP 塞進
    # X-Forwarded-For，app 的存取日誌 / 限流 / 稽核靠這個 header
    option forwardfor
    # 告知後端原始協定是 https：app 產生絕對 URL、設定 secure cookie、
    # 判斷是否強制導 https 時都依賴它
    http-request set-header X-Forwarded-Proto https
    default_backend be_app

backend be_app
    balance roundrobin
    # 真 L7 健檢（規劃書 §10 修正）：舊架構只驗「TCP 埠有開」，但 app 行程
    # 活著 ≠ 服務可用（DB 斷線、佇列滿載時埠照樣開）。GET /health 是 app
    # 自己實作的深度健檢端點，回 200 才代表「真的能服務」
    option httpchk GET /health
    http-check expect status 200
    # inter=健檢間隔 / fall=連錯幾次判死 / rise=連對幾次復活：
    # 5s×3=最慢 15s 內踢掉壞節點，2 次成功才放回來（防抖動震盪）
    default-server inter {{ haproxy_edge_check_inter }} fall {{ haproxy_edge_check_fall }} rise {{ haproxy_edge_check_rise }}
{% for h in groups['app'] %}
    server {{ h }} {{ hostvars[h].ansible_host }}:{{ app_http_port }} check
{% endfor %}

# -----------------------------------------------------------------------------
# 465：SMTPS 入口（TCP passthrough，TLS 由後端 smtp 服務自持）
# -----------------------------------------------------------------------------
frontend fe_smtps
    bind *:465
    mode tcp
    option tcplog
    # SMTP 是長交談協定：客戶端傳大附件時，單一 DATA 階段可能持續數分鐘
    # 無「來回」互動，預設 60s 逾時會誤斬，放寬到 30 分鐘
    timeout client {{ haproxy_edge_smtp_timeout }}
    default_backend be_smtps

backend be_smtps
    mode tcp
    balance roundrobin
    # tcp-check：純 TCP 握手健檢。這裡「只能」做 L4——TLS 是後端自持的，
    # HAProxy 看不進加密內容；smtp 服務的深度健康由監控層（blackbox/app
    # 自身指標）補位
    option tcp-check
    timeout server {{ haproxy_edge_smtp_timeout }}
    default-server inter {{ haproxy_edge_check_inter }} fall {{ haproxy_edge_check_fall }} rise {{ haproxy_edge_check_rise }}
{% for h in groups['app'] %}
    server {{ h }} {{ hostvars[h].ansible_host }}:{{ app_smtp_port }} check
{% endfor %}

# -----------------------------------------------------------------------------
# stats / metrics（CONVENTIONS.md §3：節點 IP:{{ haproxy_stats_port }}）
# -----------------------------------------------------------------------------
frontend stats
    # 綁「節點 IP」而非 VIP/萬用位址：兩台 lb 的 stats 各自獨立可看
    # （Prometheus 要分別抓 lb-01/lb-02 的指標，經 VIP 抓只會看到 MASTER）
    bind {{ ansible_host }}:{{ haproxy_stats_port }}
    mode http
    stats enable
    stats uri /stats
    stats refresh {{ haproxy_stats_refresh }}
    # HAProxy 3.x 內建 Prometheus exporter（免裝 haproxy_exporter sidecar）：
    # 同一個埠 /stats 給人看、/metrics 給 Prometheus 抓
    http-request use-service prometheus-exporter if { path /metrics }
