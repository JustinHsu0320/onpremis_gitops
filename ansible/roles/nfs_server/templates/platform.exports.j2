# =============================================================================
# {{ nfs_server_exports_file }} — 本專案管理的 NFS 匯出
# 由 Ansible（roles/nfs_server）產生，手改必被覆蓋；來源：group_vars/nfs.yml
#
# 欄位格式：<匯出路徑> <允許的 client 網段>(<選項>)
#
# 選項為什麼這樣選（對照 group_vars/nfs.yml 的 options）：
#   - root_squash：client 端的 root 寫進來會被降權成匿名帳號（nobody）。
#     必須假設前面任何一台 app/pg 節點都可能淪陷——攻擊者即使在 client 拿到
#     root，也無法以 root 身分改寫共享儲存上的資料，儲存層是最後一道防線。
#   - sync：伺服器「確定資料落盤」才回覆 client 寫入成功。async 比較快，
#     但伺服器斷電會丟掉已回覆成功的寫入——附件與 PG 備份都是「丟了就沒了」
#     的資料，資料安全優先於效能；效能問題靠硬體與快取解，不靠 async 賭。
#   - no_subtree_check：匯出的是完整目錄樹，關掉子樹檢查可避免檔案改名時的
#     stale file handle 問題，這也是 exports(5) 手冊建議的方向。
#   - clients 限縮到單一 VLAN 網段：儲存層的第一道防火牆——
#     不在名單上的網段連 mount 都掛不上（附件只給 app 網段、備份只給資料網段）。
# =============================================================================
# ---- NFSv4 pseudo-root（fsid=0）----
# v4-only 伺服器的教科書設計：顯式宣告一個「虛擬根」，所有 client 的掛載路徑
# 都相對於它（例：伺服器端 /export/email-proxy/attachments → client 掛
# nfs-01:/email-proxy/attachments）。不宣告時 kernel 會嘗試自動合成 pseudo-root，
# 但那要求根路徑所在檔案系統可匯出——在容器實驗室（rootfs=overlayfs）會直接失敗，
# 顯式宣告則兩個環境行為一致。根只給 ro + 各資料網段（僅供路徑遍歷，資料權限
# 由下面各資料匯出自己管）。
{{ nfs_v4_root }} {% for c in nfs_exports | map(attribute='clients') | unique %}{{ c }}(ro,fsid=0,root_squash,no_subtree_check){% if not loop.last %} {% endif %}{% endfor %}

# ---- 資料匯出 ----
{% for export in nfs_exports %}
{{ export.path }} {{ export.clients }}({{ export.options }})
{% endfor %}
