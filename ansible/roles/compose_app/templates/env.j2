{#
  env.j2 → {{ compose_app_cfg.home }}/.env（mode 0600、no_log 佈署）

  這份檔案就是「真實 app 的介面契約」：專案的全部容器拿到一模一樣的環境。
  mock 模式下 mock 容器也吃同一份——介面在 lab 就被 render/驗證過，
  prod 換映像不換介面。

  內容 = projects.<name>.compose_app.env dict 的 KEY=VALUE 原樣展開
  （值在宣告檔內引用 vault_prj_* / 拓撲變數，此處已求值完畢）。
  機密注意：佈署 task 必須 no_log: true、檔案 0600。
#}
# ===== {{ ansible_managed }} =====
# {{ compose_app_name }} 應用環境檔（單一事實來源：projects 宣告，手改必被覆蓋）
{% for env_key, env_value in compose_app_cfg.env.items() %}
{{ env_key }}={{ env_value }}
{% endfor %}
