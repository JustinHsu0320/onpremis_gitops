{#
  env.j2 → /opt/email-proxy/.env（mode 0600、no_log 佈署）

  這份檔案就是「真實 app 的介面契約」：api / worker / smtp 三個容器
  拿到一模一樣的環境變數。mock 模式下 mock 容器也吃同一份——
  介面在 lab 就被 render/驗證過，prod 換映像不換介面。

  機密注意：本檔含 DB/MQ/KeyDB 密碼與 API key，佈署 task 必須
  no_log: true、檔案 0600（root 讀就夠：docker compose 以 root 跑）。
#}
# ===== {{ ansible_managed }} =====
# email_proxy 應用環境檔（單一事實來源：Ansible template，手改必被覆蓋）

# ---------- PostgreSQL（經 PgBouncer VIP，讀寫分流） ----------
# RW 走 {{ pgbouncer_port }}（HAProxy → leader 的 PgBouncer）、
# RO 走 {{ pgbouncer_ro_port }}（HAProxy → replica 的 PgBouncer）——
# app 不需要知道誰是 leader，failover 對 app 透明。
# sslmode=verify-full：不只加密，還驗「連到的真的是 pgbouncer-vip 這個名字」
# （防中間人）；sslrootcert 指向容器內掛載的內部 CA chain
# （compose 把宿主 {{ pki_dir }} 唯讀掛到容器 /etc/email-proxy/pki，路徑兩邊一致）。
DATABASE_URL=postgresql://{{ app_pg_user }}:{{ postgres_app_password }}@pgbouncer-vip.{{ domain }}:{{ pgbouncer_port }}/{{ app_pg_db }}?sslmode=verify-full&sslrootcert=/etc/email-proxy/pki/ca.crt
# 唯讀連線（報表/查詢類負載下放 replica，減輕 leader 壓力）
DATABASE_RO_URL=postgresql://{{ app_pg_user }}:{{ postgres_app_password }}@pgbouncer-vip.{{ domain }}:{{ pgbouncer_ro_port }}/{{ app_pg_db }}?sslmode=verify-full&sslrootcert=/etc/email-proxy/pki/ca.crt

# ---------- RabbitMQ（AMQPS 經 VIP） ----------
# amqps = TLS 加密的 AMQP（5671，明文 5672 不對外）。經 rabbitmq-vip 而非
# 個別節點：單一 mq 節點故障對 app 透明（HAProxy + quorum queue 扛住）。
# vhost / user 名稱與 group_vars/rabbitmq.yml 對齊（詳見 defaults 的別名註解）。
AMQP_URL=amqps://{{ app_amqp_user }}:{{ rabbitmq_app_user_password }}@rabbitmq-vip.{{ domain }}:{{ rabbitmq_amqps_port }}/{{ app_amqp_vhost }}

# ---------- KeyDB（快取；同居設計） ----------
# 127.0.0.1 是刻意的：每台 app 節點同居一組 KeyDB（master 6379），
# 本機迴環延遲最低、也不經任何 VIP——cluster client 會從本機節點拿到
# 完整 slot 拓撲再自行路由。rediss = TLS；KeyDB 是 TLS-only + mTLS，
# 所以除了 CA 還必須帶 client 憑證（keydb-client，10-pki 簽發）。
KEYDB_URL=rediss://:{{ keydb_password }}@127.0.0.1:{{ keydb_port }}
KEYDB_TLS_CERT=/etc/email-proxy/pki/keydb-client.crt
KEYDB_TLS_KEY=/etc/email-proxy/pki/keydb-client.key
KEYDB_TLS_CA=/etc/email-proxy/pki/ca.crt

# ---------- ScyllaDB（信件/附件冷資料；CQL over TLS） ----------
# gocql driver 原生支援 cluster failover：傳入多台 host 會自動嘗試下一台
# （+ SimpleRetryPolicy），不需要 VIP、也不需要在應用層另寫迴圈——
# 所以這裡列全部節點的 FQDN（/etc/hosts 由 common role 維護，ADR-5）。
# TLS 驗證用內部 CA（容器內 /etc/email-proxy/pki 已由 compose 唯讀掛載，
# 與 PG/KeyDB 共用同一條 chain，不需要像 MIS 另掛一個 scylla 專用 certs 目錄）。
SCYLLA_HOSTS={% for h in groups['scylladb'] | sort %}{{ h }}.{{ domain }}:{{ scylla_cql_port }}{% if not loop.last %},{% endif %}{% endfor %}

SCYLLA_KEYSPACE={{ app_scylla_keyspace }}
SCYLLA_USER={{ app_scylla_user }}
SCYLLA_PASSWORD={{ scylla_app_password }}
SCYLLA_TLS_ENABLED=true
SCYLLA_CA_CERT_PATH=/etc/email-proxy/pki/ca.crt
SCYLLA_TLS_INSECURE_SKIP_VERIFY=false

# ---------- 附件儲存 ----------
# 容器內路徑；宿主側由 compose 掛 {{ attachments_mount }}（NFS 掛載點）。
# 這是規劃書的核心修正：附件寫 NFS 而非本機碟，SMTP 收信節點寫入的附件，
# worker 在「另一台節點」寄送時才讀得到。
ATTACHMENT_VOLUME_PATH=/data/attachments

# ---------- 對外連線（Graph API / SendGrid）一律經 egress proxy ----------
# 這是「app 層契約」：與主機層開關 use_egress_proxy 無關——lab 的主機層
# 雖直連出網，app 對外仍走 Squid（白名單）；否則 lab 驗不到
# 「app → egress → 外部」這段鏈路，prod 上線才踩雷。
# NO_PROXY 涵蓋內網：DB/MQ/KeyDB 等內部連線絕不可繞去 proxy。
HTTP_PROXY={{ egress_proxy_url }}
HTTPS_PROXY={{ egress_proxy_url }}
NO_PROXY={{ no_proxy_list }}

# ---------- 應用機密（值來自 vault，經 group_vars/all/vars.yml 別名注入） ----------
# Microsoft Graph API（收信 OAuth）client secret
MICROSOFT_CLIENT_SECRET={{ microsoft_client_secret }}
# SendGrid 寄信 API key
SENDGRID_API_KEY={{ sendgrid_api_key }}
# API JWT 簽章密鑰
JWT_SECRET={{ app_jwt_secret }}
# 落地資料（信件內容/附件索引）對稱加密金鑰
APP_ENCRYPTION_KEY={{ app_encryption_key }}
